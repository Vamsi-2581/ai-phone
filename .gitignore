# Runtime state lives in ~/.ai-phone by default; never commit it if it lands here
.ai-phone/
config.yaml
*.local.yaml

# Model weights (`ai-phone models pull` puts them in the Hugging Face cache, never here)
models/
*.safetensors
*.gguf
*.npz
*.onnx
*.bin

# Logs and per-turn latency records
logs/
*.log
turns.jsonl

# Audio captures and test recordings
*.wav
*.mp3
*.m4a
*.flac

# Build output (the SIP extension is built on each Mac by scripts/install.sh, not committed)
build/
dist/
*.egg-info/
*.so
*.dylib
native/pjsua2/pjproject-*/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# macOS
.DS_Store

# generated by the M1 plan; frozen after Task 3
native/pjsua2/build/
native/pjsua2/*.tar.gz
src/ai_phone/vendor/pjsua2.py
src/ai_phone/vendor/_pjsua2*.so
scripts/utt/

# Review records are kept locally, outside the repository
docs/reviews/

# Private planning documents are kept locally, outside the repository
docs/private/
docs/superpowers/
.superpowers/
AGENTS.md
